#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""
Имитация grubby (BLS-версии) для демо-режима и тестов grubby-gui.
Ничего не трогает в системе: состояние хранится в JSON-файле
$FAKE_GRUBBY_STATE (по умолчанию ~/.cache/grubby-gui-demo.json).

    GRUBBY_GUI_DEMO=$PWD/tests/fake-grubby ./grubby_gui.py
"""
import json
import os
import sys

STATE = os.environ.get("FAKE_GRUBBY_STATE") or os.path.expanduser(
    "~/.cache/grubby-gui-demo.json")

RUNNING = os.uname()[2]
ROOT = "/dev/mapper/rhel-root"
BASE = "ro crashkernel=1G-4G:192M,4G-64G:256M,64G-:512M resume=/dev/mapper/rhel-swap " \
       "rd.lvm.lv=rhel/root rd.lvm.lv=rhel/swap rhgb quiet"


def initial():
    vers = [RUNNING, "5.14.0-427.13.1.el9_4.x86_64", "5.14.0-362.24.1.el9_3.x86_64"]
    ents = []
    for v in vers:
        ents.append({"kernel": "/boot/vmlinuz-" + v, "initrd": "/boot/initramfs-%s.img" % v,
                     "title": "Red Hat Enterprise Linux (%s) 9.4 (Plow)" % v,
                     "args": "root=%s %s" % (ROOT, BASE),
                     "id": "4f3c1e2a9b8d4c7e8f6a5b4c3d2e1f00-" + v})
    ents.append({"kernel": "/boot/vmlinuz-0-rescue-4f3c1e2a9b8d4c7e8f6a5b4c3d2e1f00",
                 "initrd": "/boot/initramfs-0-rescue-4f3c1e2a9b8d4c7e8f6a5b4c3d2e1f00.img",
                 "title": "Red Hat Enterprise Linux (0-rescue-4f3c1e2a9b8d) 9.4 (Plow)",
                 "args": "root=%s %s" % (ROOT, BASE.replace(" rhgb quiet", "")),
                 "id": "4f3c1e2a9b8d4c7e8f6a5b4c3d2e1f00-0-rescue"})
    return {"entries": ents, "default": 0}


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (IOError, ValueError):
        return initial()


def save(st):
    d = os.path.dirname(STATE)
    if d and not os.path.isdir(d):
        os.makedirs(d)
    with open(STATE, "w") as f:
        json.dump(st, f, indent=1)


def toks(s):
    return s.split()


def update_args(args, add, remove):
    t = toks(args)
    for r in toks(remove):
        if "=" in r:
            t = [x for x in t if x != r]
        else:
            t = [x for x in t if x.split("=", 1)[0] != r]
    for a in toks(add):
        k = a.split("=", 1)[0]
        found = False
        for i, x in enumerate(t):
            if x.split("=", 1)[0] == k:
                t[i] = a
                found = True
        if not found:
            t.append(a)
    return " ".join(t)


def targets(st, param):
    if param == "ALL":
        return list(range(len(st["entries"])))
    if param == "DEFAULT":
        return [st["default"]]
    res = []
    for i, e in enumerate(st["entries"]):
        if param == e["kernel"] or param == str(i) or param == "TITLE=" + e["title"]:
            res.append(i)
    return res


def info(st, idxs):
    for i in idxs:
        e = st["entries"][i]
        t = toks(e["args"])
        root = [x for x in t if x.startswith("root=")]
        args = " ".join(x for x in t if not x.startswith("root="))
        print("index=%d" % i)
        print('kernel="%s"' % e["kernel"])
        print('args="%s"' % args)
        if root:
            print('root="%s"' % root[0][5:])
        print('initrd="%s"' % e["initrd"])
        print('title="%s"' % e["title"])
        print('id="%s"' % e["id"])


USAGE = """Usage: grubby [OPTION...]
      --add-kernel=kernel-path            add an entry for the specified kernel
      --args=args                         default arguments for the new kernel or new arguments for kernel being updated
      --copy-default                      use the default boot entry as a template for the new entry being added
      --default-kernel                    display the path of the default kernel
      --default-index                     display the index of the default kernel
      --default-title                     display the title of the default kernel
      --info=kernel-path                  display boot information for specified kernel
      --initrd=initrd-path                initrd image for the new kernel
      --make-default                      make the newly added entry the default boot entry
      --remove-args=STRING                remove kernel arguments
      --remove-kernel=kernel-path         remove all entries for the specified kernel
      --set-default=kernel-path           make the first entry referencing the specified kernel the default
      --set-default-index=entry-index     make the given entry index the default entry
      --title=entry-title                 title to use for the new kernel entry
      --update-kernel=kernel-path         updated information for the specified kernel
      --no-etc-grub-update                don't update the GRUB_CMDLINE_LINUX variable in /etc/default/grub
  [демо: это имитация grubby, система не изменяется]
"""


def main(argv):
    st = load()
    opts = {}
    for a in argv:
        if "=" in a:
            k, v = a.split("=", 1)
            opts[k] = v
        else:
            opts[a] = True
    if "--help" in opts:
        print(USAGE)
        return 0
    if "--default-index" in opts:
        print(st["default"])
        return 0
    if "--default-kernel" in opts:
        print(st["entries"][st["default"]]["kernel"])
        return 0
    if "--default-title" in opts:
        print(st["entries"][st["default"]]["title"])
        return 0
    if "--info" in opts:
        idxs = targets(st, opts["--info"])
        if not idxs:
            sys.stderr.write("The param %s is incorrect\n" % opts["--info"])
            return 1
        info(st, idxs)
        return 0
    if "--set-default-index" in opts:
        i = int(opts["--set-default-index"])
        if not 0 <= i < len(st["entries"]):
            sys.stderr.write("The param %d is incorrect\n" % i)
            return 1
        st["default"] = i
        save(st)
        print("The default is /boot/loader/entries/%s.conf with index %d and kernel %s" % (
            st["entries"][i]["id"], i, st["entries"][i]["kernel"]))
        return 0
    if "--set-default" in opts:
        idxs = targets(st, opts["--set-default"])
        if not idxs:
            sys.stderr.write("The param %s is incorrect\n" % opts["--set-default"])
            return 1
        st["default"] = idxs[0]
        save(st)
        return 0
    if "--update-kernel" in opts:
        idxs = targets(st, opts["--update-kernel"])
        if not idxs:
            sys.stderr.write("The param %s is incorrect\n" % opts["--update-kernel"])
            return 1
        for i in idxs:
            e = st["entries"][i]
            e["args"] = update_args(e["args"], opts.get("--args", ""), opts.get("--remove-args", ""))
        save(st)
        return 0
    if "--remove-kernel" in opts:
        k = opts["--remove-kernel"]
        idxs = targets(st, k)
        if not idxs:
            sys.stderr.write("The param %s is incorrect\n" % k)
            return 1
        dk = st["entries"][st["default"]]["kernel"]
        st["entries"] = [e for i, e in enumerate(st["entries"]) if i not in idxs]
        st["default"] = next((i for i, e in enumerate(st["entries"]) if e["kernel"] == dk), 0)
        save(st)
        return 0
    if "--add-kernel" in opts:
        k = opts["--add-kernel"]
        base = os.path.basename(k)
        v = base[8:] if base.startswith("vmlinuz-") else base
        args = ""
        if "--copy-default" in opts:
            args = st["entries"][st["default"]]["args"]
        if opts.get("--args"):
            args = update_args(args, opts["--args"], "")
        e = {"kernel": k, "initrd": opts.get("--initrd", ""),
             "title": opts.get("--title", base), "args": args, "id": "custom-" + v}
        st["entries"].insert(0, e)
        st["default"] = 0 if "--make-default" in opts else st["default"] + 1
        save(st)
        return 0
    sys.stderr.write("no action specified\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
